# Copy to .env and edit. Placeholder values only - never commit the real .env.
# Paths below are paths INSIDE the container (see volumes in docker-compose.yml).

# Public HTTPS origin of the site (no path). Must start with https://
XGIFT_ORIGIN=https://xp.example.com

# Upstream only accepts a loopback listen address.
XGIFT_LISTEN=127.0.0.1:8787

# Data dir (vault.db, site.db, locks) -> ./data on the host
XGIFT_DATA_DIR=/var/lib/xgift

# Secret files -> ./secrets on the host; must be mode 0600 and owned by UID 10001
XGIFT_PASSWORD_FILE=/etc/xgift/vault-password
XGIFT_ADMIN_PASSWORD_FILE=/etc/xgift/admin-password

# true = accept public redemptions/payments, false = paused (codes not consumed)
XGIFT_PAYMENTS_ENABLED=false

# Optional Cloudflare Turnstile. Set both or leave both empty.
XGIFT_TURNSTILE_SITE_KEY=
# e.g. /etc/xgift/turnstile-secret
XGIFT_TURNSTILE_SECRET_FILE=

# Container timezone (tzdata is installed in the image)
TZ=Asia/Shanghai

# docker compose settings (not read by the app)
# Default builds locally as xgift:local. To use a prebuilt image instead:
# XGIFT_IMAGE=ghcr.io/<your-github-user>/x_gift_bot:latest
CADDYFILE=./deploy/Caddyfile
